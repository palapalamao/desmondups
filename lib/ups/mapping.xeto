// ============================================================================
// lib/ups/mapping.xeto — 外部编码映射（P3；红线 R5 模型位）
// 四条约束：
// 1 同一（来源系统+外部编码）同一时刻只能有一组生效映射，生效期不得重叠
// 2 一对多拆分时，同组比例之和必须为 1
// 3 编码/组织变更只新增带新生效期的版本，不修改历史映射 → 历史期可无损重算
// 4 未映射编码不丢弃，进未映射池保留数据，细粒度标注不完整
// 落库同时保留 原始外部编码 + 当时所用映射版本引用：映射补齐后可按原始编码
// 回溯重算，无需重新向外部系统取数（重取成本远高于多存两列）。
// ============================================================================

upsExtCodeMap : Proj {
  sourceSys:      Str        // 来源系统（bms/ems/资产台账…）
  extCode:        Str        // 外部编码（厂商码/协议码/资产编号）
  upsTag:         Ref        // 映射到的本库标签/枚举项
  version:        Int        // 映射版本号，只递增（R5）
  effectiveStart: DateTime   // 生效起
  effectiveEnd:   DateTime?  // 生效止（null = 当前生效）
  ratio:          Number = 1 // 拆分比例；一对多拆分组之和必须为 1
  mapRef:         Ref?       // 数据侧回写：当时所用映射版本引用
}
