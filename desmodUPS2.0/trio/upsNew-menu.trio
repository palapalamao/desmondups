// upsNew FIN 顶栏菜单。仅打开只读监测界面。
---
name: upsNewApp
finStackMobileMenu
func
overridable
doc: "在 FIN 顶栏注册 upsNew UPS 运行监测应用。"
src:
  () => do
    root: "/pod/upsNew/ui/index-0.2.3.html"
    action: "top.app.LoadApplication('" + root + "#overview', null, null, {app: '_upsNew'});top.app.ToggleCollapse(true);"
    [{
      displayName: "upsNew",
      appId: "upsNewApp",
      link: "",
      icon: "icon-bolt",
      iconType: "class",
      ui: "mobile",
      minUiTarget: "phone",
      order: -220,
      action: action,
      keepOpen: true
    }].toGrid
  end
