# Local FIN runtime, dependencies and deployment backups
/work/
/build/
/deployment-backups/
**/node_modules/
**/__pycache__/
*.pyc
*.log
.env
.env.*
!.env.example

# Superseded generated bundles and local deployment attempts
/ui/*-0.2.[12].*
/scripts/deploy-upsNew-0.1.1-*.ps1
